# Copy this file to .env and fill in your values

# Stripe publishable key (get from https://dashboard.stripe.com/apikeys)
# Use pk_test_... for testing, pk_live_... for production
VITE_STRIPE_PK=pk_test_your_stripe_publishable_key_here

# Backend API URL (used if not proxied through Vite)
# VITE_API_URL=https://myparking-backend.onrender.com
